# Environment Configuration Template
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Flask environment (development, production, testing)
FLASK_ENV=development

# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-this-in-production

# Debug mode (True for development, False for production)
DEBUG=True

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Company name (used for database naming)
COMPANY_NAME=THE HEALTH COLLECTIVE INC.

# Database URI
# Development (SQLite): sqlite:///the_health_collective_inc.db
# Production (PostgreSQL): postgresql://user:password@localhost:5432/dbname
SQLALCHEMY_DATABASE_URI=sqlite:///the_health_collective_inc.db

# Track modifications (set to False for performance)
SQLALCHEMY_TRACK_MODIFICATIONS=False

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# CSRF token settings
CSRF_TOKEN_NAME=_csrf_token
CSRF_TOKEN_BYTES=16

# Session cookie settings
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# =============================================================================
# MAINTENANCE MODE
# =============================================================================

# Enable/disable maintenance mode
MAINTENANCE_MODE=False

# =============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# =============================================================================

# Mail server settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@thehealthcollective.com

# =============================================================================
# CACHING (Optional - for performance)
# =============================================================================

# Cache type (simple, filesystem, redis)
CACHE_TYPE=simple

# Cache timeout in seconds (default: 300 = 5 minutes)
CACHE_DEFAULT_TIMEOUT=300

# Redis cache settings (if using redis)
# CACHE_REDIS_URL=redis://localhost:6379/0

# =============================================================================
# LOGGING (Optional - for debugging)
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/thci.log

# =============================================================================
# PERFORMANCE & OPTIMIZATION
# =============================================================================

# Enable query profiling (development only)
SQLALCHEMY_ECHO=False

# Enable template auto-reload (development only)
TEMPLATES_AUTO_RELOAD=True

# =============================================================================
# TIMEZONE
# =============================================================================

# Application timezone (always Asia/Manila for Philippine operations)
TIMEZONE=Asia/Manila

# =============================================================================
# FILE UPLOADS (Optional)
# =============================================================================

# Maximum file upload size in bytes (default: 16MB)
MAX_CONTENT_LENGTH=16777216

# Upload folder path
UPLOAD_FOLDER=instance/uploads

# =============================================================================
# NOTES
# =============================================================================

# To generate a secure secret key, run:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# For production deployment:
#   1. Set FLASK_ENV=production
#   2. Set DEBUG=False
#   3. Generate strong SECRET_KEY
#   4. Use PostgreSQL for SQLALCHEMY_DATABASE_URI
#   5. Set SESSION_COOKIE_SECURE=True (requires HTTPS)
#   6. Configure proper MAIL settings
#   7. Consider using Redis for CACHE_TYPE
